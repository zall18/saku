generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Transaction {
  id            String   @id @default(cuid())
  userId        String // Supabase auth.users ID
  amount        Int // dalam Rupiah (tanpa desimal)
  description   String?
  category      String // "daily" | "transport" | "entertainment"
  subCategory   String? // "makan_siang", "kopi", dll
  paymentSource String // "qris" | "brimo" | "cash" | "ewallet" | "dana" | "gopay"
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
  @@index([createdAt])
  @@index([category])
}

model Budget {
  id     String @id @default(cuid())
  userId String // Supabase auth.users ID
  month  Int // 1-12
  year   Int
  amount Int // target budget bulanan dalam Rupiah

  @@unique([userId, month, year])
  @@index([userId])
}

model Shortcut {
  id            String  @id @default(cuid())
  userId        String? // null = preset bawaan, ada nilai = kustom user
  label         String // "Makan Siang"
  icon          String // emoji "🍚"
  amount        Int // nominal default
  category      String
  subCategory   String?
  paymentSource String
  sortOrder     Int     @default(0)
  isActive      Boolean @default(true)

  @@index([userId])
}
